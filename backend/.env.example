APP_NAME=Trace API
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://trace:trace@localhost:5432/trace
REDIS_URL=redis://localhost:6379/0
GITHUB_TOKEN=
GITHUB_MAX_RETRIES=3
GITHUB_MAX_RETRY_DELAY_SECONDS=30
GITHUB_ISSUE_LIMIT=200
GITHUB_PULL_REQUEST_LIMIT=100
GITHUB_REVIEW_LIMIT_PER_PULL_REQUEST=100
GITHUB_CHANGED_FILE_LIMIT_PER_ARTIFACT=300
GITHUB_COMMIT_LIMIT=100
GITHUB_RELEASE_LIMIT=100
GITHUB_CONTRIBUTOR_LIMIT=100
GITHUB_LABEL_LIMIT=200
GITHUB_ARCHIVE_MAX_BYTES=250000000
GITHUB_SOURCE_FILE_MAX_BYTES=1000000
EMBEDDING_BATCH_SIZE=64
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
OPENAI_SUBSYSTEM_ENRICHMENT_ENABLED=false
OPENAI_SUBSYSTEM_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_MAX_RETRIES=2
OPENAI_MAX_RETRY_DELAY_SECONDS=15
OPENAI_TIMEOUT_SECONDS=60
CORS_ORIGINS=http://localhost:5173
